{
    "name": "TheLongAfter",
    "short_name": "TLA",
    "description": "We Come Back Wearing Someone Else's Face | Horror. Love. Mystical. Dreamy. Strange. Stories, poems, novels and more — written from the space after everything ends.",
    "version": "3.0.0",
    "start_url": "/",
    "scope": "/",
    "id": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "browser"],
    "orientation": "any",
    "background_color": "#0A0A0A",
    "theme_color": "#8B0000",
    "lang": "en-US",
    "dir": "ltr",

    "icons": [
        {
            "src": "/icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/maskable-icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-384x384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-256x256.png",
            "sizes": "256x256",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/maskable-icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-152x152.png",
            "sizes": "152x152",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-144x144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-128x128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-96x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-72x72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-48x48.png",
            "sizes": "48x48",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-32x32.png",
            "sizes": "32x32",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-16x16.png",
            "sizes": "16x16",
            "type": "image/png",
            "purpose": "any"
        }
    ],

    "shortcuts": [
        {
            "name": "All Works",
            "short_name": "Works",
            "description": "Browse all writings in TheLongAfter collection — stories, poems, novels and more",
            "url": "/#works",
            "icons": [
                {
                    "src": "/icons/shortcut-poems.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Stories",
            "short_name": "Stories",
            "description": "What haunts you in TheLongAfter? Enter the stories.",
            "url": "/#works?category=stories",
            "icons": [
                {
                    "src": "/icons/shortcut-sonnets.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Poems",
            "short_name": "Poems",
            "description": "Words that bleed — dark poetry from TheLongAfter",
            "url": "/#works?category=poems",
            "icons": [
                {
                    "src": "/icons/shortcut-heartbreak.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Novels",
            "short_name": "Novels",
            "description": "Full-length dark fiction — novels from TheLongAfter",
            "url": "/#works?category=novels",
            "icons": [
                {
                    "src": "/icons/shortcut-submit.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Submit Writing",
            "short_name": "Submit",
            "description": "Submit your own stories, poems or novels to TheLongAfter",
            "url": "/#submit",
            "icons": [
                {
                    "src": "/icons/shortcut-submit.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],

    "screenshots": [
        {
            "src": "/pmcoverpg.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "TheLongAfter — Desktop View | We Come Back Wearing Someone Else's Face"
        },
        {
            "src": "/pmcoverpg.png",
            "sizes": "750x1334",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "TheLongAfter — Mobile View | We Come Back Wearing Someone Else's Face"
        }
    ],

    "categories": [
        "books",
        "education",
        "entertainment",
        "lifestyle",
        "magazines"
    ],

    "prefer_related_applications": false,
    "related_applications": [
        {
            "platform": "webapp",
            "url": "https://thelongafter.onrender.com/manifest.json"
        }
    ],

    "handle_links": "preferred",

    "launch_handler": {
        "client_mode": ["navigate-existing", "auto"]
    },

    "edge_side_panel": {
        "preferred_width": 400
    },

    "share_target": {
        "action": "/#submit",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "workTitle",
            "text": "workContent",
            "url": "workUrl"
        }
    },

    "protocol_handlers": [
        {
            "protocol": "web+thelongafter",
            "url": "/#work?id=%s"
        }
    ],

    "file_handlers": [
        {
            "action": "/#submit",
            "accept": {
                "text/plain": [
                    ".txt",
                    ".poem",
                    ".story",
                    ".novel",
                    ".dark",
                    ".md"
                ]
            }
        }
    ],

    "widgets": [
        {
            "name": "Read of the Day",
            "short_name": "Daily Read",
            "description": "Display today's featured story, poem or novel from TheLongAfter on your home screen",
            "tag": "thelongafter-daily-read",
            "template": "read-of-day",
            "ms_ac_template": "widgets/read-template.json",
            "data": "api/read-of-day.json",
            "type": "application/vnd.microsoft.card.adaptive",
            "screenshots": [
                {
                    "src": "widgets/read-widget-preview.png",
                    "sizes": "300x400",
                    "label": "TheLongAfter — Read of the Day Widget"
                }
            ],
            "icons": [
                {
                    "src": "icons/widget-icon.png",
                    "sizes": "64x64",
                    "type": "image/png"
                }
            ],
            "backgrounds": [
                {
                    "src": "widgets/widget-bg.png",
                    "sizes": "300x400",
                    "type": "image/png"
                }
            ],
            "auth": false,
            "update": 3600
        },
        {
            "name": "Reading Stats",
            "short_name": "Stats",
            "description": "View your reading statistics on TheLongAfter",
            "tag": "thelongafter-stats",
            "template": "reading-stats",
            "ms_ac_template": "widgets/stats-template.json",
            "data": "api/reading-stats.json",
            "type": "application/vnd.microsoft.card.adaptive",
            "screenshots": [
                {
                    "src": "widgets/stats-widget-preview.png",
                    "sizes": "300x200",
                    "label": "TheLongAfter — Reading Stats Widget"
                }
            ],
            "icons": [
                {
                    "src": "icons/widget-icon.png",
                    "sizes": "64x64",
                    "type": "image/png"
                }
            ],
            "update": 1800
        },
        {
            "name": "Poem of the Day",
            "short_name": "Daily Poem",
            "description": "A dark poem from TheLongAfter delivered to your home screen daily",
            "tag": "thelongafter-daily-poem",
            "template": "poem-of-day",
            "ms_ac_template": "widgets/poem-template.json",
            "data": "api/poem-of-day.json",
            "type": "application/vnd.microsoft.card.adaptive",
            "screenshots": [
                {
                    "src": "widgets/poem-widget-preview.png",
                    "sizes": "300x400",
                    "label": "TheLongAfter — Poem of the Day Widget"
                }
            ],
            "icons": [
                {
                    "src": "icons/widget-icon.png",
                    "sizes": "64x64",
                    "type": "image/png"
                }
            ],
            "backgrounds": [
                {
                    "src": "widgets/widget-bg.png",
                    "sizes": "300x400",
                    "type": "image/png"
                }
            ],
            "auth": false,
            "update": 86400
        },
        {
            "name": "Novel Chapter",
            "short_name": "Chapter",
            "description": "Read the latest chapter from TheLongAfter novels on your home screen",
            "tag": "thelongafter-novel-chapter",
            "template": "novel-chapter",
            "ms_ac_template": "widgets/novel-template.json",
            "data": "api/latest-chapter.json",
            "type": "application/vnd.microsoft.card.adaptive",
            "screenshots": [
                {
                    "src": "widgets/novel-widget-preview.png",
                    "sizes": "300x400",
                    "label": "TheLongAfter — Novel Chapter Widget"
                }
            ],
            "icons": [
                {
                    "src": "icons/widget-icon.png",
                    "sizes": "64x64",
                    "type": "image/png"
                }
            ],
            "backgrounds": [
                {
                    "src": "widgets/widget-bg.png",
                    "sizes": "300x400",
                    "type": "image/png"
                }
            ],
            "auth": false,
            "update": 3600
        }
    ]
}